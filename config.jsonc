    {
      "type": "os",
      "key": "├─ OS",
      "keyColor": "#2A629E",
      "format": "{#38;2;200;200;200}{pretty-name} {arch}",
    },
    {
      "type": "kernel",
      "key": "├─ Kernel",
      "keyColor": "#2A629E",
      "format": "{#38;2;200;200;200}{sysname} {release}",
    },
    {
      "type": "uptime",
      "key": "├─ Uptime",
      "keyColor": "#2A629E",
      "format": "{#38;2;200;200;200}{formatted}",
    },
    {
      "type": "locale",
      "key": "├─ Locale",
      "keyColor": "#2A629E",
      "format": "{#38;2;200;200;200}{result}",
    },
    {
      "type": "datetime",
      "key": "└─ Date & Time",
      "keyColor": "#2A629E",
      "format": "{#38;2;200;200;200}{year}-{month-pretty}-{day-pretty} {hour-pretty}:{minute-pretty}:{second-pretty}",
    },
    "break",
    {
      "type": "custom",
      "format": "{#38;2;176;144;112}Hardware",
    },
    {
      "type": "cpu",
      "key": "├─ CPU",
      "keyColor": "#B09070",
      "format": "{#38;2;200;200;200}{name} ({core-types}) @ {freq-max}",
    },
    {
      "type": "cpuusage",
      "key": "├─ CPU Usage",
      "keyColor": "#B09070",
      "percent": { "type": 1 },
      "format": "{#38;2;200;200;200}{avg}",
    },
    {
      "type": "gpu",
      "key": "├─ GPU",
      "keyColor": "#B09070",
      "format": "{#38;2;200;200;200}{name} ({core-count}) @ {frequency} [{type}]",
    },
    {
      "type": "disk",
      "key": "├─ Disk ({mountpoint})",
      "keyColor": "#B09070",
      "percent": { "type": 1 },
      "format": "{#38;2;200;200;200}{size-used} / {size-total} ({size-percentage}) - {filesystem}{?is-readonly} [Read-only]{?}",
    },
    {
      "type": "memory",
      "key": "└─ Memory",
      "keyColor": "#B09070",
      "percent": { "type": 1 },
      "format": "{#38;2;200;200;200}{used} / {total} ({percentage})",
    },
    "break",
    {
      "type": "custom",
      "format": "{#38;2;112;112;112}Red",
    },
    {
      "type": "localip",
      "key": "└─ Local IP ({ifname})",
      "keyColor": "#707070",
      "format": "{#38;2;200;200;200}{ipv4}",
    },
  ],
